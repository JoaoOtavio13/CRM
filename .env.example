# ============================================================
#  Vendas CRM - Variáveis de ambiente (plantilla)
#  Copia este archivo a `.env` e completa com seus valores:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
#  NUNCA subas o `.env` real ao repositório.
# ============================================================

# --- Django core ---
# Gera um valor seguro: https://djecrety.herokuapp.com/
SECRET_KEY=change-me-a-secure-random-string
# True apenas em desenvolvimento; em produção SEMPRE False
DEBUG=True
# Hosts permitidos separados por vírgula (sem espaços)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (SMTP) ---
# Exemplo para Gmail (usar "Application Password", não a contraseña normal)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@example.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-app