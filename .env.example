# ============================================================
#  Vendas CRM - Variáveis de ambiente (modelo)
#  Copie este arquivo para `.env` e complete com seus valores:
#      copy .env.example .env  (Windows)
#      cp .env.example .env    (Linux/macOS)
#  NUNCA envie o `.env` real para o repositório.
# ============================================================

# --- Django core ---
# Gere um valor seguro: https://djecrety.herokuapp.com/
SECRET_KEY=change-me-a-secure-random-string
# True apenas em desenvolvimento; em produção use SEMPRE False
DEBUG=True
# Hosts permitidos separados por vírgula (sem espaços)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (SMTP) ---
# Exemplo para Gmail (usar "Senha de app", não a senha normal da conta)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@example.com
EMAIL_HOST_PASSWORD=sua-senha-de-app

# --- Banco de dados (apenas em produção) ---
# Se definido, o projeto usa PostgreSQL; se vazio, usa o SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/vendas_crm

# --- Cloudinary (mídia em produção) ---
# Preencha para guardar os uploads no Cloudinary.
# Se deixar vazio, os uploads ficam no disco local (media/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=